<?xml version="1.0"?>
<robot name="energia_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include the base rover model -->
  <xacro:include filename="$(find energia_sim)/urdf/energia_rover.urdf.xacro"/>

  <!-- Include ultrasonic sensors -->
  <xacro:include filename="$(find energia_sim)/urdf/sensors/ultrasonic_sensors.xacro"/>

  <!-- Include LiDAR, Camera, and GPS -->
  <xacro:include filename="$(find energia_sim)/urdf/sensors/lidar_camera_gps.xacro"/>

  <!-- ==================== Gazebo Harmonic Plugins ==================== -->

  <!-- Differential Drive Controller for Skid-Steer -->
  <!-- Using ros_gz_bridge for cmd_vel and odometry -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Wheel joints -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Kinematics -->
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.1016</wheel_radius>

      <!-- Limits -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>

      <!-- Topics - Use absolute paths to match ros_gz_bridge -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <!-- NOTE: TF is NOT published here - odom_to_tf node handles TF to avoid
           timestamp synchronization issues between Gazebo sim time and ROS2 -->

      <!-- Frames -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <!-- Publish odometry -->
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher for wheel visualization -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
