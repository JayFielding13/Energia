<?xml version="1.0"?>
<robot name="energia_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Properties/Constants ==================== -->

  <!-- Chassis dimensions (converted to meters) -->
  <xacro:property name="chassis_length" value="0.6858"/>    <!-- 27 inches -->
  <xacro:property name="chassis_width" value="0.60325"/>    <!-- 23.75 inches -->
  <xacro:property name="chassis_height" value="0.3048"/>    <!-- 12 inches -->
  <xacro:property name="chassis_mass" value="90.7"/>        <!-- 200 lbs total rover weight -->

  <!-- Electronics box dimensions -->
  <xacro:property name="ebox_length" value="0.3048"/>       <!-- 12 inches -->
  <xacro:property name="ebox_width" value="0.3048"/>        <!-- 12 inches -->
  <xacro:property name="ebox_height" value="0.2032"/>       <!-- 8 inches -->
  <xacro:property name="ebox_mass" value="5.0"/>            <!-- ~11 lbs for electronics -->

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_radius" value="0.127"/>       <!-- 5 inch radius (10 inch diameter) -->
  <xacro:property name="wheel_width" value="0.0762"/>       <!-- 3 inches -->
  <xacro:property name="wheel_mass" value="4.5"/>           <!-- ~10 lbs per wheel -->

  <!-- Wheel positioning -->
  <xacro:property name="wheelbase" value="0.4318"/>         <!-- 17 inches between front and rear wheels -->
  <xacro:property name="track_width" value="0.60325"/>      <!-- 23.75 inches -->
  <xacro:property name="ground_clearance" value="0.0762"/>  <!-- 3 inches -->

  <!-- Calculated positions -->
  <xacro:property name="rear_wheel_x" value="${-chassis_length/2 + wheel_radius}"/>
  <xacro:property name="front_wheel_x" value="${rear_wheel_x + wheelbase}"/>
  <xacro:property name="wheel_y" value="${track_width/2}"/>
  <xacro:property name="wheel_z" value="${-chassis_height/2 + wheel_radius - ground_clearance}"/>

  <!-- Center of mass: 4 inches above bottom edge of chassis -->
  <xacro:property name="com_z_offset" value="${-chassis_height/2 + 0.1016}"/>

  <!-- RPLidar A1 specs -->
  <xacro:property name="lidar_radius" value="0.038"/>       <!-- 76mm diameter / 2 -->
  <xacro:property name="lidar_height" value="0.039"/>       <!-- 39mm height -->
  <xacro:property name="lidar_mass" value="0.170"/>         <!-- 170 grams -->

  <!-- Ultrasonic sensor specs -->
  <xacro:property name="ultrasonic_min_range" value="0.20"/>
  <xacro:property name="ultrasonic_max_range" value="6.0"/>
  <xacro:property name="ultrasonic_fov" value="1.22"/>      <!-- 70 degrees -->
  <xacro:property name="sensor_z_offset" value="0.1270"/>   <!-- 11 inches from ground -->

  <!-- ==================== Wheel Macro ==================== -->

  <xacro:macro name="wheel" params="prefix x_offset y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"
          ixy="0.0" ixz="0.0"
          iyy="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"
          iyz="0.0"
          izz="${wheel_mass * wheel_radius * wheel_radius / 2}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <!-- Gazebo Harmonic wheel surface properties -->
    <gazebo reference="${prefix}_wheel">
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
      </material>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>0.5</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>10000000.0</kp>
            <kd>1.0</kd>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </gazebo>
  </xacro:macro>

  <!-- ==================== Ultrasonic Sensor Macro ==================== -->

  <xacro:macro name="ultrasonic" params="name x y yaw">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.04"/>
        </geometry>
        <material name="gray">
          <color rgba="0.3 0.3 0.3 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.04"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${sensor_z_offset}" rpy="0 0 ${yaw}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <topic>ultrasonic/${name}</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>${-ultrasonic_fov/2}</min_angle>
              <max_angle>${ultrasonic_fov/2}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${ultrasonic_min_range}</min>
            <max>${ultrasonic_max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <gz_frame_id>${name}_link</gz_frame_id>
      </sensor>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.3 0.3 0.3 1</diffuse>
      </material>
    </gazebo>
  </xacro:macro>

  <!-- ==================== Base Footprint (Ground Projection) ==================== -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_link is at chassis center height above ground -->
    <origin xyz="0 0 ${ground_clearance + wheel_radius + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Base Link (Chassis) ==================== -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${com_z_offset}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass * (chassis_width * chassis_width + chassis_height * chassis_height) / 12}"
        ixy="0.0" ixz="0.0"
        iyy="${chassis_mass * (chassis_length * chassis_length + chassis_height * chassis_height) / 12}"
        iyz="0.0"
        izz="${chassis_mass * (chassis_length * chassis_length + chassis_width * chassis_width) / 12}"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>
      <ambient>1.0 0.5 0.0 1</ambient>
      <diffuse>1.0 0.5 0.0 1</diffuse>
    </material>
    <surface>
      <friction>
        <ode>
          <mu>0.2</mu>
          <mu2>0.2</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  <!-- ==================== Wheels ==================== -->

  <xacro:wheel prefix="front_left" x_offset="${front_wheel_x}" y_offset="${wheel_y}"/>
  <xacro:wheel prefix="front_right" x_offset="${front_wheel_x}" y_offset="${-wheel_y}"/>
  <xacro:wheel prefix="rear_left" x_offset="${rear_wheel_x}" y_offset="${wheel_y}"/>
  <xacro:wheel prefix="rear_right" x_offset="${rear_wheel_x}" y_offset="${-wheel_y}"/>

  <!-- ==================== Electronics Box ==================== -->

  <link name="electronics_box">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${ebox_length} ${ebox_width} ${ebox_height}"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${ebox_length} ${ebox_width} ${ebox_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${ebox_mass}"/>
      <inertia
        ixx="${ebox_mass * (ebox_width * ebox_width + ebox_height * ebox_height) / 12}"
        ixy="0.0" ixz="0.0"
        iyy="${ebox_mass * (ebox_length * ebox_length + ebox_height * ebox_height) / 12}"
        iyz="0.0"
        izz="${ebox_mass * (ebox_length * ebox_length + ebox_width * ebox_width) / 12}"/>
    </inertial>
  </link>

  <joint name="electronics_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="electronics_box"/>
    <origin xyz="0 0 ${chassis_height/2 + ebox_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="electronics_box">
    <material>
      <ambient>0.3 0.3 0.3 1</ambient>
      <diffuse>0.3 0.3 0.3 1</diffuse>
    </material>
  </gazebo>

  <!-- ==================== RPLidar A1 ==================== -->

  <link name="rplidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${lidar_mass * (3 * lidar_radius * lidar_radius + lidar_height * lidar_height) / 12}"
        ixy="0.0" ixz="0.0"
        iyy="${lidar_mass * (3 * lidar_radius * lidar_radius + lidar_height * lidar_height) / 12}"
        iyz="0.0"
        izz="${lidar_mass * lidar_radius * lidar_radius / 2}"/>
    </inertial>
  </link>

  <joint name="rplidar_joint" type="fixed">
    <parent link="electronics_box"/>
    <child link="rplidar_link"/>
    <!-- Centered on top of electronics box -->
    <origin xyz="0 0 ${ebox_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="rplidar_link">
    <sensor name="rplidar_a1" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>${2*pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <gz_frame_id>rplidar_link</gz_frame_id>
    </sensor>
    <material>
      <ambient>0.1 0.1 0.1 1</ambient>
      <diffuse>0.1 0.1 0.1 1</diffuse>
    </material>
  </gazebo>

  <!-- ==================== IMU Sensor ==================== -->

  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <gz_frame_id>base_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ==================== Ultrasonic Sensors ==================== -->

  <!-- Front sensor (0 deg) -->
  <xacro:ultrasonic name="ultrasonic_front" x="${chassis_length/2}" y="0" yaw="0"/>

  <!-- Front corners (45 deg) -->
  <xacro:ultrasonic name="ultrasonic_front_left" x="${chassis_length/2 * 0.8}" y="${chassis_width/2 * 0.8}" yaw="${pi/4}"/>
  <xacro:ultrasonic name="ultrasonic_front_right" x="${chassis_length/2 * 0.8}" y="${-chassis_width/2 * 0.8}" yaw="${-pi/4}"/>

  <!-- Side sensors (90 deg) -->
  <xacro:ultrasonic name="ultrasonic_left" x="0.1143" y="${chassis_width/2}" yaw="${pi/2}"/>
  <xacro:ultrasonic name="ultrasonic_right" x="0.1143" y="${-chassis_width/2}" yaw="${-pi/2}"/>

  <!-- Rear sensor (180 deg) -->
  <xacro:ultrasonic name="ultrasonic_rear" x="${-chassis_length/2}" y="0" yaw="${pi}"/>

  <!-- ==================== Gazebo Harmonic Plugins ==================== -->

  <!-- Differential Drive Controller (Skid-Steer) -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_odom>true</publish_odom>
      <!-- TF is NOT bridged from Gazebo. odom_to_tf node converts /odom to TF
           with consistent sim time timestamps to avoid "jump back in time" errors -->
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher - DISABLED
       Wheel joint states are not bridged from Gazebo because the gz.msgs.Model
       format doesn't convert properly to sensor_msgs/JointState and causes
       timestamp issues. The wheels are continuous joints so their positions
       don't affect the TF tree - robot_state_publisher handles all robot links.
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
  -->

</robot>
