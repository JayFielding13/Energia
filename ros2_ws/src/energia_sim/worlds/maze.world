<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="maze_world">

    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Gazebo Harmonic plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- OPEN TRAINING MAZE                             -->
    <!-- 24m x 24m arena with very wide corridors       -->
    <!-- 8m spacing between walls                       -->
    <!-- 8m wide openings for easy navigation           -->
    <!-- Simple X/Y aligned walls only                  -->
    <!-- ============================================== -->

    <!-- OUTER BOUNDARY WALLS -->

    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 12 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24.3 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24.3 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.45 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -12 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24.3 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24.3 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.45 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>12 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 24 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 24 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.45 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-12 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 24 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 24 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.45 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- INTERNAL WALLS - Simple X/Y aligned           -->
    <!-- 8m segments with 8m gaps                       -->
    <!-- ============================================== -->

    <!-- Upper horizontal wall (Y = 4) - left segment only, 8m gap on right -->
    <model name="wall_h_upper">
      <static>true</static>
      <pose>-8 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.25 1</ambient>
            <diffuse>0.6 0.45 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lower horizontal wall (Y = -4) - right segment only, 8m gap on left -->
    <model name="wall_h_lower">
      <static>true</static>
      <pose>8 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.25 1</ambient>
            <diffuse>0.6 0.45 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Center vertical wall (X = 0) - middle segment, 8m gaps top and bottom -->
    <model name="wall_v_center">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.25 1</ambient>
            <diffuse>0.6 0.45 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- OBSTACLES - Spread out for sensor testing      -->
    <!-- ============================================== -->

    <!-- Box obstacle - upper right quadrant -->
    <model name="obstacle_box_01">
      <static>true</static>
      <pose>6 8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material>
            <ambient>0.2 0.6 0.3 1</ambient>
            <diffuse>0.3 0.7 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cylinder obstacle - lower left quadrant -->
    <model name="obstacle_cylinder_01">
      <static>true</static>
      <pose>-6 -8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.2 0.6 1</ambient>
            <diffuse>0.7 0.3 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low obstacle - center area -->
    <model name="obstacle_low_01">
      <static>true</static>
      <pose>-6 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
          <material>
            <ambient>0.8 0.6 0.2 1</ambient>
            <diffuse>0.9 0.7 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- APRILTAG STANDS - 8 tags in open areas         -->
    <!-- Note: AprilTag textures need to be configured  -->
    <!-- for Gazebo Harmonic separately                 -->
    <!-- ============================================== -->

    <!-- AprilTag 0 - Upper left quadrant -->
    <model name="apriltag_0">
      <static>true</static>
      <pose>-8 8 0.5 1.5708 0 -0.785</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag 1 - Upper right quadrant -->
    <model name="apriltag_1">
      <static>true</static>
      <pose>8 8 0.5 1.5708 0 -2.356</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag 2 - Center left -->
    <model name="apriltag_2">
      <static>true</static>
      <pose>-8 0 0.5 1.5708 0 0</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag 3 - Center right -->
    <model name="apriltag_3">
      <static>true</static>
      <pose>8 0 0.5 1.5708 0 3.14159</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag 4 - Lower left quadrant -->
    <model name="apriltag_4">
      <static>true</static>
      <pose>-8 -8 0.5 1.5708 0 0.785</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag 5 - Lower right quadrant -->
    <model name="apriltag_5">
      <static>true</static>
      <pose>8 -8 0.5 1.5708 0 2.356</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag 6 - Top center -->
    <model name="apriltag_6">
      <static>true</static>
      <pose>0 10 0.5 1.5708 0 -1.5708</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag 7 - Bottom center -->
    <model name="apriltag_7">
      <static>true</static>
      <pose>0 -10 0.5 1.5708 0 1.5708</pose>
      <link name="link">
        <collision name="tag_collision">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
        </collision>
        <visual name="tag_visual">
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
